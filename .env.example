# Optional — only needed if you want the agent's action-proposal step to
# call an LLM instead of the deterministic rule-based proposer.
ANTHROPIC_API_KEY=

# Optional — only needed for the live-data path (data/razorpay_client.py),
# which pulls real failed payments from your own Razorpay account instead
# of the bundled demo dataset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
